    <replace><![CDATA[<xf:if is="$showPreparedReplies"><xf:title>Hazır Cevaplar</xf:title><xf:else /><xf:title>Hata Bildirimleri</xf:title></xf:if>]]></replace>
  </modification>
  <modification type="admin" template="wrxt_hata_admin_list" modification_key="wrxt_hata_prepared_reply_button" description="Hazır cevap yönetimi ve kategori butonlarını ekler" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:pageaction><xf:button href="{{ link('options/groups/wrxtHataSettings') }}" icon="cog">Ayarlar</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics') }}">İstatistikler</xf:button></xf:pageaction>]]></find>
    <replace><![CDATA[<xf:if is="$showPreparedReplies">
<xf:pageaction><xf:button href="{{ link('wrxt-hata-hazir-cevaplar/add') }}" icon="add">Hazır cevap ekle</xf:button><xf:button href="{{ link('wrxt-hata-hazir-cevaplar/category-add') }}" icon="add">Kategori ekle</xf:button></xf:pageaction>
<xf:else />
<xf:pageaction><xf:button href="{{ link('options/groups/wrxtHataSettings') }}" icon="cog">Ayarlar</xf:button><xf:button href="{{ link('wrxt-hata-hazir-cevaplar') }}" icon="reply">Hazır Cevaplar</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics') }}">İstatistikler</xf:button></xf:pageaction>
</xf:if>]]></replace>
  </modification>
  <modification type="admin" template="wrxt_hata_admin_list" modification_key="wrxt_hata_prepared_reply_manager" description="Hazır cevapları kategori başlıkları altında tema uyumlu kartlarla yönetir" execution_order="20" enabled="1" action="str_replace">
    <find><![CDATA[<div class="block"><div class="block-container"><h2 class="block-header">Genel durum</h2>]]></find>
    <replace><![CDATA[<xf:if is="$showPreparedReplies">
<div class="block"><div class="block-container"><h2 class="block-header">Hazır Mesaj Şablonları</h2><div class="block-body"><div class="block-row">Hazır cevapları kategoriler altında düzenleyebilir, gösterim sırasını belirleyebilir ve XenForo BBCode editörüyle içerik oluşturabilirsiniz.</div></div></div></div>

<xf:foreach loop="$preparedReplyGroups" value="$group">
<div class="block"><div class="block-container">
<h2 class="block-header"><span class="label label--primary">Kategori</span> {$group.category.title}<span class="u-pullRight"><span class="buttonGroup"><xf:button href="{{ link('wrxt-hata-hazir-cevaplar/category-edit', null, {'prepared_reply_category_id': $group.category.prepared_reply_category_id}) }}" class="button--small button--link" icon="edit">Düzenle</xf:button><xf:form action="{{ link('wrxt-hata-hazir-cevaplar/category-delete') }}" class="u-inline"><xf:hiddenval name="prepared_reply_category_id" value="{$group.category.prepared_reply_category_id}" /><xf:button type="submit" class="button--small button--link" icon="delete">Sil</xf:button></xf:form></span></span></h2>
<div class="block-body">
<xf:if is="$group.replies is not empty"><xf:foreach loop="$group.replies" value="$preparedReply"><div class="block-row block-row--separated"><div class="contentRow"><div class="contentRow-main"><div class="contentRow-title"><strong>{$preparedReply.title}</strong> <xf:if is="!$preparedReply.active"><span class="label">Pasif</span><xf:else /><span class="label label--green">Aktif</span></xf:if></div><div class="contentRow-minor">Hazır cevap · Sıra: {$preparedReply.display_order}</div><div class="contentRow-snippet"><div class="formRow-explain">Cevap içeriği</div><div class="bbWrapper">{$preparedReply.message|snippet(180)}</div></div></div><div class="contentRow-extra"><div class="buttonGroup"><xf:button href="{{ link('wrxt-hata-hazir-cevaplar/edit', null, {'prepared_reply_id': $preparedReply.prepared_reply_id}) }}" class="button--small button--link" icon="edit">Düzenle</xf:button><xf:form action="{{ link('wrxt-hata-hazir-cevaplar/delete') }}" class="u-inline"><xf:hiddenval name="prepared_reply_id" value="{$preparedReply.prepared_reply_id}" /><xf:button type="submit" class="button--small button--link" icon="delete">Sil</xf:button></xf:form></div></div></div></div></xf:foreach><xf:else /><div class="block-row u-muted">Bu kategoride hazır cevap yok.</div></xf:if>
</div></div></div>
</xf:foreach>

<xf:if is="$uncategorizedPreparedReplies is not empty">
<div class="block"><div class="block-container"><h2 class="block-header"><span class="label">Grup</span> Kategorisiz</h2><div class="block-body"><xf:foreach loop="$uncategorizedPreparedReplies" value="$preparedReply"><div class="block-row block-row--separated"><div class="contentRow"><div class="contentRow-main"><div class="contentRow-title"><strong>{$preparedReply.title}</strong> <xf:if is="!$preparedReply.active"><span class="label">Pasif</span><xf:else /><span class="label label--green">Aktif</span></xf:if></div><div class="contentRow-minor">Hazır cevap · Sıra: {$preparedReply.display_order}</div><div class="contentRow-snippet"><div class="formRow-explain">Cevap içeriği</div><div class="bbWrapper">{$preparedReply.message|snippet(180)}</div></div></div><div class="contentRow-extra"><div class="buttonGroup"><xf:button href="{{ link('wrxt-hata-hazir-cevaplar/edit', null, {'prepared_reply_id': $preparedReply.prepared_reply_id}) }}" class="button--small button--link" icon="edit">Düzenle</xf:button><xf:form action="{{ link('wrxt-hata-hazir-cevaplar/delete') }}" class="u-inline"><xf:hiddenval name="prepared_reply_id" value="{$preparedReply.prepared_reply_id}" /><xf:button type="submit" class="button--small button--link" icon="delete">Sil</xf:button></xf:form></div></div></div></div></xf:foreach></div></div></div>
</xf:if>

<xf:if is="$preparedReplyEdit">
<xf:form action="{{ link('wrxt-hata-hazir-cevaplar/save') }}" class="block"><div class="block-container"><h2 class="block-header"><xf:if is="$preparedReplyEdit.prepared_reply_id">Hazır Cevabı Düzenle<xf:else />Yeni Hazır Cevap</xf:if></h2><div class="block-body"><xf:hiddenval name="prepared_reply_id" value="{$preparedReplyEdit.prepared_reply_id}" /><xf:textboxrow name="title" value="{$preparedReplyEdit.title}" maxlength="100" label="Başlık" required="required" /><xf:editorrow name="message" value="{$preparedReplyEdit.message}" data-min-height="180" label="Mesaj" explain="XenForo varsayılan editörü ve BBCode kullanılabilir." /><xf:selectrow name="prepared_reply_category_id" value="{$preparedReplyEdit.prepared_reply_category_id}" label="Kategori"><xf:option value="0">Kategorisiz</xf:option><xf:foreach loop="$preparedReplyCategories" value="$preparedReplyCategory"><xf:option value="{$preparedReplyCategory.prepared_reply_category_id}">{$preparedReplyCategory.title}</xf:option></xf:foreach></xf:selectrow><xf:numberboxrow name="display_order" value="{$preparedReplyEdit.display_order}" min="0" label="Gösterim sırası" /><xf:checkboxrow><xf:option name="active" value="1" selected="$preparedReplyEdit.active">Aktif</xf:option></xf:checkboxrow></div><xf:submitrow submit="Kaydet" /></div></xf:form>
</xf:if>

<xf:if is="$preparedReplyCategoryEdit">
<xf:form action="{{ link('wrxt-hata-hazir-cevaplar/category-save') }}" class="block"><div class="block-container"><h2 class="block-header"><xf:if is="$preparedReplyCategoryEdit.prepared_reply_category_id">Kategoriyi Düzenle<xf:else />Yeni Hazır Cevap Kategorisi</xf:if></h2><div class="block-body"><xf:hiddenval name="prepared_reply_category_id" value="{$preparedReplyCategoryEdit.prepared_reply_category_id}" /><xf:textboxrow name="category_title" value="{$preparedReplyCategoryEdit.title}" maxlength="100" label="Kategori adı" required="required" /><xf:numberboxrow name="category_display_order" value="{$preparedReplyCategoryEdit.display_order}" min="0" label="Gösterim sırası" /></div><xf:submitrow submit="Kaydet" /></div></xf:form>
</xf:if>
<xf:else />
<div class="block"><div class="block-container"><h2 class="block-header">Genel durum</h2>]]></replace>
  </modification>
  <modification type="admin" template="wrxt_hata_admin_list" modification_key="wrxt_hata_prepared_reply_mode_close" description="Hazır cevap modunda hata listesi içeriklerini gizler" execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[<xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-hata-bildirimleri" params="{{ {'q': $q, 'status': $status, 'category': $category, 'assignee_user_id': $assigneeUserId} }}" wrapperclass="block-outer block-outer--after" /></div></xf:form>]]></find>
    <replace><![CDATA[$0
</xf:if>]]></replace>
  </modification>
  <modification type="admin" template="wrxt_hata_admin_view" modification_key="wrxt_hata_admin_bbcode_messages" description="Yetkili ekranında mesajları BBCode ile gösterir" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<div class="bbWrapper">{$item.message|nl2br}</div>]]></find>
    <replace><![CDATA[<div class="bbWrapper">{{ bb_code($item.message, 'wrxt_bug_report', $item.User) }}</div>]]></replace>
  </modification>
  <modification type="admin" template="wrxt_hata_admin_view" modification_key="wrxt_hata_admin_reply_editor" description="Hazır cevap seçildiğinde otomatik olarak XenForo editörüne yükler" execution_order="20" enabled="1" action="str_replace">
    <find><![CDATA[<xf:form action="{{ link('wrxt-hata-bildirimleri/reply') }}" class="block"><div class="block-container"><h2 class="block-header">Kullanıcıya cevap yaz</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:textarearow name="message" rows="5" maxlength="10000" autosize="true" label="Cevap" /></div><xf:submitrow submit="Cevabı gönder" /></div></xf:form>]]></find>
    <replace><![CDATA[<xf:if is="$preparedReplyGroups is not empty OR $uncategorizedPreparedReplies is not empty"><xf:form action="{{ link('wrxt-hata-bildirimleri/view') }}#wrxt-hata-reply-editor" method="get" class="block" data-wrxt-prepared-reply-form="1"><div class="block-container"><h2 class="block-header">Hazır cevap kullan</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:selectrow name="prepared_reply_id" value="{$preparedReplyId}" label="Hazır cevap" explain="Bir hazır cevap seçtiğiniz anda içerik otomatik olarak aşağıdaki cevap editörüne yüklenir."><xf:option value="0">Hazır cevap seçin</xf:option><xf:foreach loop="$preparedReplyGroups" value="$group"><xf:optgroup label="{$group.category.title}"><xf:foreach loop="$group.replies" value="$preparedReply"><xf:option value="{$preparedReply.prepared_reply_id}">{$preparedReply.title}</xf:option></xf:foreach></xf:optgroup></xf:foreach><xf:if is="$uncategorizedPreparedReplies is not empty"><xf:optgroup label="Kategorisiz"><xf:foreach loop="$uncategorizedPreparedReplies" value="$preparedReply"><xf:option value="{$preparedReply.prepared_reply_id}">{$preparedReply.title}</xf:option></xf:foreach></xf:optgroup></xf:if></xf:selectrow></div></div></xf:form><xf:js>
(() => {
    const form = document.querySelector('[data-wrxt-prepared-reply-form="1"]')
    if (!form) return
    const select = form.querySelector('select[name="prepared_reply_id"]')
    if (!select) return
    select.addEventListener('change', () => {
        if (select.value !== '0') form.submit()
    })
})()
</xf:js></xf:if>
<xf:form id="wrxt-hata-reply-editor" action="{{ link('wrxt-hata-bildirimleri/reply') }}" class="block"><div class="block-container"><h2 class="block-header">Kullanıcıya cevap yaz</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:editorrow name="message" value="{$preparedReplyMessage}" maxlength="10000" data-min-height="160" label="Cevap" explain="Hazır cevap seçildikten sonra içeriği değiştirebilir; XenForo BBCode ve biçimlendirme araçlarını kullanabilirsiniz." /></div><xf:submitrow submit="Cevabı gönder" /></div></xf:form>]]></replace>
  </modification>
  <modification type="admin" template="wrxt_hata_admin_view" modification_key="wrxt_hata_log_actor_username" description="İşlem geçmişinde yetkili ID yerine kullanıcı adı gösterir" execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[<xf:if is="$log.actor_user_id">#{$log.actor_user_id}<xf:else />Sistem</xf:if>]]></find>
    <replace><![CDATA[<xf:if is="$log.Actor">{$log.Actor.username}<xf:elseif is="$log.actor_user_id" />Silinmiş kullanıcı<xf:else />Sistem</xf:if>]]></replace>
  </modification>
</template_modifications>
