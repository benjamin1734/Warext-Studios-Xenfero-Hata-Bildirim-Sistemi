<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="wrxt_hata_report_form" version_id="1000130" version_string="1.0.5"><![CDATA[<xf:title>Hata Bildir</xf:title>
<xf:form action="{{ link('hata-bildir/submit') }}" ajax="true" class="block" data-wrxt-hata-form="1">
    <div class="block-container">
        <h2 class="block-header">Hata Bildir</h2>
        <div class="block-body">
            <xf:selectrow name="category" value="other" label="Sorun türü">
                <xf:option value="page">Sayfa çalışmıyor</xf:option>
                <xf:option value="visual">Görsel / tasarım hatası</xf:option>
                <xf:option value="feature">Buton / özellik çalışmıyor</xf:option>
                <xf:option value="mobile">Mobil uyumluluk</xf:option>
                <xf:option value="performance">Performans problemi</xf:option>
                <xf:option value="permission">Yetki problemi</xf:option>
                <xf:option value="other">Diğer</xf:option>
            </xf:selectrow>
            <xf:textarearow name="description" maxlength="5000" rows="6" autosize="true" label="Sorunu açıklayın" explain="Sorunun ne zaman ve hangi işlem sırasında oluştuğunu kısaca anlatın." />
            <xf:if is="$attachmentData">
                <xf:formrow label="Ekran görüntüsü / dosya" explain="Sorunu göstermeye yardımcı olacak ekran görüntüsü veya desteklenen bir dosya ekleyebilirsiniz.">
                    <xf:macro template="public:helper_attach_upload" name="upload_block" arg-attachmentData="{$attachmentData}" />
                </xf:formrow>
            </xf:if>
            <div class="formRow"><div class="formRow-labelWrapper"><label class="formRow-label">Otomatik teknik bilgiler</label></div><div class="formRow-main"><div class="formRow-explain">Bulunduğunuz URL, tarayıcı, cihaz, ekran, tema ve içerik bağlamı otomatik eklenir. Form içerikleri, şifreler ve yetkilendirme verileri kaydedilmez.</div></div></div>
            <input type="hidden" name="current_url" value="{$currentUrl}" />
            <input type="hidden" name="screen_width" value="0" />
            <input type="hidden" name="screen_height" value="0" />
            <input type="hidden" name="viewport_width" value="0" />
            <input type="hidden" name="viewport_height" value="0" />
            <input type="hidden" name="pixel_ratio" value="1" />
            <input type="hidden" name="timezone" value="" />
            <input type="hidden" name="user_agent" value="" />
            <input type="hidden" name="js_enabled" value="0" />
            <input type="hidden" name="client_errors_json" value="" />
            <input type="hidden" name="network_errors_json" value="" />
        </div>
        <xf:submitrow submit="Hata Bildirimini Gönder" />
    </div>
</xf:form>
<xf:js>
(() => {
    const form = document.querySelector('[data-wrxt-hata-form="1"]')
    if (!form) return
    const set = (name, value) => { const input = form.querySelector('[name="' + name + '"]'); if (input) input.value = value ?? '' }
    const populate = () => {
        set('current_url', window.location.href)
        set('screen_width', window.screen?.width || 0)
        set('screen_height', window.screen?.height || 0)
        set('viewport_width', window.innerWidth || 0)
        set('viewport_height', window.innerHeight || 0)
        set('pixel_ratio', window.devicePixelRatio || 1)
        set('timezone', Intl.DateTimeFormat().resolvedOptions().timeZone || '')
        set('user_agent', navigator.userAgent || '')
        set('js_enabled', 1)
        if (window.WrxtHataDiagnostics) window.WrxtHataDiagnostics.populate(form)
    }
    populate()
    form.addEventListener('submit', populate)
})()
</xf:js>]]></template>

  <template type="public" title="wrxt_hata_report_mine" version_id="1000130" version_string="1.0.5"><![CDATA[<xf:title>Hata Bildirimlerim</xf:title>
<div class="block"><div class="block-container"><h2 class="block-header">Hata Bildirimlerim</h2><div class="block-body">
<xf:if is="$reports"><xf:datalist data-xf-init="responsive-datalist"><xf:foreach loop="$reports" value="$report"><xf:datarow rowclass="dataList-row--noHover"><xf:main><xf:label><a href="{{ link('hata-bildirimlerim/view', null, {'report_id': $report.report_id}) }}"><strong>{$report.report_key}</strong></a></xf:label><xf:explain>{$report.description|snippet(100)} · <xf:date time="$report.created_date" /></xf:explain></xf:main><xf:cell><xf:if is="$report.status == 'new'">Yeni<xf:elseif is="$report.status == 'investigating'" />İnceleniyor<xf:elseif is="$report.status == 'confirmed'" />Onaylandı<xf:elseif is="$report.status == 'in_progress'" />Çözülüyor<xf:elseif is="$report.status == 'resolved'" />Çözüldü<xf:elseif is="$report.status == 'cannot_reproduce'" />Tekrar üretilemedi<xf:elseif is="$report.status == 'invalid'" />Geçersiz<xf:elseif is="$report.status == 'duplicate'" />Yinelenen<xf:else />Arşivlendi</xf:if></xf:cell></xf:datarow></xf:foreach></xf:datalist><xf:else /><div class="block-row">Henüz hata bildiriminiz bulunmuyor.</div></xf:if>
</div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="hata-bildirimlerim" wrapperclass="block-outer block-outer--after" /></div></div>]]></template>

  <template type="public" title="wrxt_hata_report_view" version_id="1000130" version_string="1.0.5"><![CDATA[<xf:title>{$report.report_key}</xf:title>
<div class="block"><div class="block-container"><h2 class="block-header">{$report.report_key}</h2><div class="block-body">
<div class="block-row"><dl class="pairs pairs--columns pairs--fixedSmall"><dt>Durum</dt><dd><xf:if is="$report.status == 'new'">Yeni<xf:elseif is="$report.status == 'investigating'" />İnceleniyor<xf:elseif is="$report.status == 'confirmed'" />Onaylandı<xf:elseif is="$report.status == 'in_progress'" />Çözülüyor<xf:elseif is="$report.status == 'resolved'" />Çözüldü<xf:elseif is="$report.status == 'cannot_reproduce'" />Tekrar üretilemedi<xf:elseif is="$report.status == 'invalid'" />Geçersiz<xf:elseif is="$report.status == 'duplicate'" />Yinelenen<xf:else />Arşivlendi</xf:if></dd><dt>Bildirim zamanı</dt><dd><xf:date time="$report.created_date" /></dd><dt>Sayfa</dt><dd><a href="{$report.current_url}" target="_blank" rel="noopener noreferrer">{$report.current_url}</a></dd><dt>Tarayıcı</dt><dd>{$report.browser_name} {$report.browser_version}</dd><dt>İşletim sistemi</dt><dd>{$report.os_name}</dd><dt>Cihaz</dt><dd>{$report.device_type}</dd><dt>Ekran</dt><dd>{$report.screen_width} × {$report.screen_height}</dd><dt>Görüntü alanı</dt><dd>{$report.viewport_width} × {$report.viewport_height}</dd><xf:if is="$report.content_type"><dt>İçerik bağlamı</dt><dd>{$report.content_type} #{$report.content_id}</dd></xf:if><dt>Tanılama</dt><dd>{$report.js_error_count} JavaScript · {$report.network_error_count} ağ hatası</dd></dl></div>
<div class="block-row block-row--separated"><h3 class="block-minorHeader">Açıklama</h3><div class="bbWrapper">{$report.description|nl2br}</div></div>
<xf:if is="$report.Attachments is not empty"><div class="block-row block-row--separated"><h3 class="block-minorHeader">Ek dosyalar</h3><ul class="listInline listInline--bullet"><xf:foreach loop="$report.Attachments" value="$attachment"><li><a href="{{ link('attachments', $attachment) }}" target="_blank" rel="noopener">{$attachment.Data.filename}</a> <span class="u-muted">{{ file_size($attachment.Data.file_size) }}</span></li></xf:foreach></ul></div></xf:if>
</div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Görüşme</h2><div class="block-body"><xf:if is="$messages is not empty"><xf:foreach loop="$messages" value="$item"><div class="block-row block-row--separated"><strong>{$item.username}</strong><xf:if is="$item.message_type == 'staff'"><span class="label label--blue">Yetkili</span></xf:if><div class="u-muted"><xf:date time="$item.created_date" /></div><div class="bbWrapper">{$item.message|nl2br}</div></div></xf:foreach><xf:else /><div class="block-row">Henüz ek mesaj bulunmuyor.</div></xf:if></div></div></div>
<xf:if is="$canReply"><xf:form action="{{ link('hata-bildirimlerim/reply') }}" class="block"><div class="block-container"><h2 class="block-header">Cevap yaz</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:textarearow name="message" rows="5" maxlength="10000" autosize="true" label="Mesajınız" /></div><xf:submitrow submit="Cevabı gönder" /></div></xf:form></xf:if>]]></template>

  <template type="public" title="alert_wrxt_bug_report_staff_reply" version_id="1000130" version_string="1.0.5"><![CDATA[<a href="{{ link('hata-bildirimlerim/view', null, {'report_id': $content.report_id}) }}"><strong>{$content.report_key}</strong></a> hata bildiriminize yetkili yanıt verdi.]]></template>
  <template type="public" title="alert_wrxt_bug_report_status" version_id="1000130" version_string="1.0.5"><![CDATA[<a href="{{ link('hata-bildirimlerim/view', null, {'report_id': $content.report_id}) }}"><strong>{$content.report_key}</strong></a> hata bildiriminizin durumu güncellendi.]]></template>
  <template type="public" title="push_wrxt_bug_report_staff_reply" version_id="1000130" version_string="1.0.5"><![CDATA[{$content.report_key} hata bildiriminize yetkili yanıt verdi.]]></template>
  <template type="public" title="push_wrxt_bug_report_status" version_id="1000130" version_string="1.0.5"><![CDATA[{$content.report_key} hata bildiriminizin durumu güncellendi.]]></template>
  <template type="public" title="wrxt_hata.less" version_id="1000130" version_string="1.0.5"><![CDATA[.wrxtHata-floatingButton { position: fixed; right: 22px; bottom: 22px; z-index: @zIndex-4; }
.wrxtHata-footerButton { padding: @xf-paddingLarge 0; text-align: center; }
.wrxtHata-reportButton { font-weight: 700; font-size: @xf-fontSizeNormal; box-shadow: 0 4px 16px rgba(0,0,0,.22); border-radius: @xf-borderRadiusLarge; padding: 10px 16px; }
.wrxtHata-reportButton .fa { margin-right: 6px; }
.wrxtHata-diagnosticItem { padding: @xf-paddingMedium 0; border-bottom: 1px solid @xf-borderColorLight; }
.wrxtHata-diagnosticItem:last-child { border-bottom: 0; }
@media (max-width: @xf-responsiveMedium) { .wrxtHata-floatingButton { right: 12px; bottom: 12px; } .wrxtHata-reportButton { padding: 9px 13px; } }]]></template>

  <template type="admin" title="wrxt_hata_admin_list" version_id="1000130" version_string="1.0.5"><![CDATA[<xf:title>Hata Bildirimleri</xf:title>
<xf:pageaction><xf:button href="{{ link('options/groups/wrxtHataSettings') }}" icon="cog">Ayarlar</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics') }}">İstatistikler</xf:button></xf:pageaction>
<div class="block"><div class="block-container"><h2 class="block-header">Genel durum</h2><div class="block-body"><div class="block-row"><div class="pairs-group pairs-group--columns"><dl class="pairs pairs--columns"><dt>Yeni</dt><dd>{{ $stats.new ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>İnceleniyor</dt><dd>{{ $stats.investigating ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Onaylandı</dt><dd>{{ $stats.confirmed ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Çözülüyor</dt><dd>{{ $stats.in_progress ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Çözüldü</dt><dd>{{ $stats.resolved ?: 0 }}</dd></dl></div></div></div></div></div>
<xf:if is="$hotspots is not empty"><div class="block"><div class="block-container"><h2 class="block-header">Yoğun hata sinyalleri · Son 30 dakika</h2><div class="block-body"><table class="dataList-table"><thead><tr><th>Sayfa</th><th>Bildirim</th><th>Kullanıcı</th><th>Son bildirim</th></tr></thead><tbody><xf:foreach loop="$hotspots" value="$hotspot"><tr><td><a href="{$hotspot.current_url}" target="_blank" rel="noopener noreferrer">{$hotspot.current_url|snippet(110)}</a></td><td><strong>{$hotspot.report_count}</strong></td><td>{$hotspot.user_count}</td><td><xf:date time="$hotspot.last_date" /></td></tr></xf:foreach></tbody></table></div></div></div></xf:if>
<xf:form action="{{ link('wrxt-hata-bildirimleri') }}" method="get" class="block"><div class="block-container"><h2 class="block-header">Filtrele</h2><div class="block-body"><xf:textboxrow name="q" value="{$q}" label="Rapor veya kullanıcı" placeholder="BUG-A1B2C3D4, rapor ID veya kullanıcı adı" /><xf:selectrow name="status" value="{$status}" label="Durum"><xf:option value="">Tümü</xf:option><xf:option value="new">Yeni</xf:option><xf:option value="investigating">İnceleniyor</xf:option><xf:option value="confirmed">Onaylandı</xf:option><xf:option value="in_progress">Çözülüyor</xf:option><xf:option value="resolved">Çözüldü</xf:option><xf:option value="cannot_reproduce">Tekrar üretilemedi</xf:option><xf:option value="invalid">Geçersiz</xf:option><xf:option value="duplicate">Yinelenen</xf:option><xf:option value="archived">Arşivlendi</xf:option></xf:selectrow><xf:selectrow name="category" value="{$category}" label="Sorun türü"><xf:option value="">Tümü</xf:option><xf:option value="page">Sayfa çalışmıyor</xf:option><xf:option value="visual">Görsel / tasarım</xf:option><xf:option value="feature">Buton / özellik</xf:option><xf:option value="mobile">Mobil uyumluluk</xf:option><xf:option value="performance">Performans</xf:option><xf:option value="permission">Yetki</xf:option><xf:option value="other">Diğer</xf:option></xf:selectrow><xf:selectrow name="assignee_user_id" value="{$assigneeUserId}" label="Atanan personel"><xf:option value="0">Tümü</xf:option><xf:foreach loop="$staff" value="$staffUser"><xf:option value="{$staffUser.user_id}">{$staffUser.username}</xf:option></xf:foreach></xf:selectrow></div><xf:submitrow submit="Filtrele" /></div></xf:form>
<xf:form action="{{ link('wrxt-hata-bildirimleri/bulk') }}" class="block"><div class="block-container"><h2 class="block-header">Hata raporları</h2><div class="block-body"><xf:if is="$reports is not empty"><table class="dataList-table"><thead><tr><th></th><th>Rapor</th><th>Kullanıcı</th><th>Bağlam</th><th>Durum</th><th>Tanılama</th><th>Atanan</th><th>Tarih</th></tr></thead><tbody><xf:foreach loop="$reports" value="$report"><tr><td><input type="checkbox" name="report_ids[]" value="{$report.report_id}" /></td><td><a href="{{ link('wrxt-hata-bildirimleri/view', null, {'report_id': $report.report_id}) }}"><strong>{$report.report_key}</strong></a><div class="u-muted">{$report.description|snippet(90)}</div></td><td>{$report.username}</td><td><xf:if is="$report.content_type">{$report.content_type} #{$report.content_id}<xf:else />{$report.category}</xf:if></td><td>{$report.status}</td><td><xf:if is="$report.js_error_count"><span class="label label--red">JS {$report.js_error_count}</span></xf:if> <xf:if is="$report.network_error_count"><span class="label label--orange">HTTP {$report.network_error_count}</span></xf:if><xf:if is="!$report.js_error_count AND !$report.network_error_count AND !$report.server_error_id"><span class="u-muted">Yok</span></xf:if></td><td><xf:if is="$report.Assignee">{$report.Assignee.username}<xf:else />Atanmamış</xf:if></td><td><xf:date time="$report.created_date" /></td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Henüz hata bildirimi bulunmuyor.</div></xf:if></div>
<xf:if is="$reports is not empty"><div class="block-body"><xf:selectrow name="bulk_action" label="Toplu işlem"><xf:option value="status">Durum değiştir</xf:option><xf:option value="assign">Personele ata</xf:option><xf:option value="resolve">Çözüldü olarak işaretle</xf:option><xf:option value="archive">Arşivle</xf:option></xf:selectrow><xf:selectrow name="bulk_status" value="investigating" label="Yeni durum"><xf:option value="new">Yeni</xf:option><xf:option value="investigating">İnceleniyor</xf:option><xf:option value="confirmed">Onaylandı</xf:option><xf:option value="in_progress">Çözülüyor</xf:option><xf:option value="resolved">Çözüldü</xf:option><xf:option value="cannot_reproduce">Tekrar üretilemedi</xf:option><xf:option value="invalid">Geçersiz</xf:option><xf:option value="archived">Arşivlendi</xf:option></xf:selectrow><xf:selectrow name="bulk_assignee_user_id" label="Atanacak personel"><xf:option value="0">Atamayı kaldır</xf:option><xf:foreach loop="$staff" value="$staffUser"><xf:option value="{$staffUser.user_id}">{$staffUser.username}</xf:option></xf:foreach></xf:selectrow><xf:textboxrow name="fixed_in_version" maxlength="100" label="Çözülen sürüm" /><xf:textarearow name="resolution_note" maxlength="10000" rows="3" autosize="true" label="Çözüm notu" /></div><xf:submitrow submit="Seçili raporlara uygula" /></xf:if><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-hata-bildirimleri" params="{{ {'q': $q, 'status': $status, 'category': $category, 'assignee_user_id': $assigneeUserId} }}" wrapperclass="block-outer block-outer--after" /></div></xf:form>]]></template>

  <template type="admin" title="wrxt_hata_admin_view" version_id="1000130" version_string="1.0.5"><![CDATA[<xf:title>{$report.report_key}</xf:title>
<xf:pageaction><xf:button href="{{ link('wrxt-hata-bildirimleri') }}" icon="back">Hata listesine dön</xf:button><xf:button href="{{ link('options/groups/wrxtHataSettings') }}" icon="cog">Ayarlar</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics') }}">İstatistikler</xf:button></xf:pageaction>
<xf:if is="$report.PossibleDuplicate AND $report.status != 'duplicate'"><div class="blockMessage blockMessage--warning"><strong>Benzer hata adayı: {$report.PossibleDuplicate.report_key} · Güven {$report.duplicate_score}%</strong><br />Birleştirme yalnızca yetkili onayıyla yapılır.</div></xf:if>
<div class="block"><div class="block-container"><h2 class="block-header">{$report.report_key} · {$report.username}</h2><div class="block-body"><div class="block-row"><h3 class="block-minorHeader">Kullanıcı açıklaması</h3><div class="bbWrapper">{$report.description|nl2br}</div></div><div class="block-row block-row--separated"><dl class="pairs pairs--columns pairs--fixedSmall">
<dt>Bildirim zamanı</dt><dd><xf:date time="$report.created_date" /></dd>
<dt>Sayfa</dt><dd><a href="{$report.current_url}" target="_blank" rel="noopener noreferrer">{$report.current_url}</a></dd>
<dt>Yönlendiren</dt><dd><xf:if is="$report.referrer_url">{$report.referrer_url}<xf:else />Yok</xf:if></dd>
<dt>Rota</dt><dd><xf:if is="$report.route_name">{$report.route_name}<xf:else />Algılanamadı</xf:if></dd>
<dt>İçerik</dt><dd><xf:if is="$report.content_type">{$report.content_type} #{$report.content_id}<xf:else />Algılanamadı</xf:if></dd>
<dt>Tarayıcı</dt><dd>{$report.browser_name} {$report.browser_version}</dd>
<dt>İşletim sistemi</dt><dd>{$report.os_name}</dd>
<dt>Cihaz</dt><dd>{$report.device_type}</dd>
<dt>Ekran</dt><dd>{$report.screen_width} × {$report.screen_height}</dd>
<dt>Görüntü alanı</dt><dd>{$report.viewport_width} × {$report.viewport_height}</dd>
<dt>Tema</dt><dd><xf:if is="$style">{$style.title} (#{$report.style_id})<xf:else />#{$report.style_id}</xf:if></dd>
<dt>Dil</dt><dd><xf:if is="$language">{$language.title}<xf:else />#{$report.language_id}</xf:if></dd>
<dt>JS hatası</dt><dd>{$report.js_error_count}</dd>
<dt>Ağ hatası</dt><dd>{$report.network_error_count}</dd>
<dt>Sunucu eşleşmesi</dt><dd><xf:if is="$report.server_error_id">#{$report.server_error_id} · {$report.server_error_score}%<xf:else />Yok</xf:if></dd>
<dt>Çözülen sürüm</dt><dd><xf:if is="$report.fixed_in_version">{$report.fixed_in_version}<xf:else />Belirtilmedi</xf:if></dd>
</dl></div>
<xf:if is="$report.resolution_note"><div class="block-row block-row--separated"><h3 class="block-minorHeader">Çözüm notu</h3><div class="bbWrapper">{$report.resolution_note|nl2br}</div></div></xf:if>
<xf:if is="$report.Attachments is not empty"><div class="block-row block-row--separated"><h3 class="block-minorHeader">Ek dosyalar</h3><ul><xf:foreach loop="$report.Attachments" value="$attachment"><li><a href="{{ link('attachments', $attachment) }}" target="_blank" rel="noopener">{$attachment.Data.filename}</a></li></xf:foreach></ul></div></xf:if>
</div></div></div>
<xf:if is="$serverError is not empty"><div class="block"><div class="block-container"><h2 class="block-header">XenForo sunucu hata korelasyonu</h2><div class="block-body"><div class="block-row"><strong>{$serverError.message}</strong><div class="u-muted">{$serverError.type} · {$serverError.file}:{$serverError.line}</div></div><xf:if is="$serverError.trace"><div class="block-row block-row--separated"><pre class="code">{$serverError.trace}</pre></div></xf:if></div></div></div></xf:if>
<xf:if is="$clientErrors is not empty OR $networkErrors is not empty"><div class="block"><div class="block-container"><h2 class="block-header">Otomatik teknik tanılama</h2><div class="block-body"><xf:foreach loop="$clientErrors" value="$diag"><div class="block-row block-row--separated"><span class="label label--red">JS</span> <strong>{$diag.message}</strong><div class="u-muted">{$diag.source}</div></div></xf:foreach><xf:foreach loop="$networkErrors" value="$diag"><div class="block-row block-row--separated"><span class="label label--orange">HTTP</span> <strong>{$diag.method} · {$diag.status}</strong><div><code>{$diag.url}</code></div></div></xf:foreach></div></div></div></xf:if>
<xf:form action="{{ link('wrxt-hata-bildirimleri/update') }}" class="block"><div class="block-container"><h2 class="block-header">Rapor yönetimi</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:selectrow name="status" value="{$report.status}" label="Durum"><xf:option value="new">Yeni</xf:option><xf:option value="investigating">İnceleniyor</xf:option><xf:option value="confirmed">Onaylandı</xf:option><xf:option value="in_progress">Çözülüyor</xf:option><xf:option value="resolved">Çözüldü</xf:option><xf:option value="cannot_reproduce">Tekrar üretilemedi</xf:option><xf:option value="invalid">Geçersiz</xf:option><xf:option value="duplicate">Yinelenen</xf:option><xf:option value="archived">Arşivlendi</xf:option></xf:selectrow><xf:selectrow name="assignee_user_id" value="{$report.assignee_user_id}" label="Atanan personel"><xf:option value="0">Atanmamış</xf:option><xf:foreach loop="$staff" value="$staffUser"><xf:option value="{$staffUser.user_id}">{$staffUser.username}</xf:option></xf:foreach></xf:selectrow><xf:textboxrow name="fixed_in_version" value="{$report.fixed_in_version}" maxlength="100" label="Çözülen sürüm" /><xf:textarearow name="resolution_note" value="{$report.resolution_note}" rows="4" maxlength="10000" autosize="true" label="Çözüm notu" /></div><xf:submitrow submit="Kaydet" /></div></xf:form>
<xf:if is="$report.status != 'duplicate'"><xf:form action="{{ link('wrxt-hata-bildirimleri/duplicate') }}" class="block"><div class="block-container"><h2 class="block-header">Yinelenen rapor</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:numberboxrow name="master_report_id" min="1" label="Ana rapor ID" /></div><xf:submitrow submit="Yinelenen olarak birleştir" /></div></xf:form></xf:if>
<div class="block"><div class="block-container"><h2 class="block-header">Yazışmalar ve ekip notları</h2><div class="block-body"><xf:if is="$messages is not empty"><xf:foreach loop="$messages" value="$item"><div class="block-row block-row--separated"><strong>{$item.username}</strong> <xf:if is="$item.message_type == 'note'"><span class="label label--orange">İç not</span><xf:elseif is="$item.message_type == 'staff'" /><span class="label label--blue">Yetkili cevabı</span></xf:if><div class="u-muted"><xf:date time="$item.created_date" /></div><div class="bbWrapper">{$item.message|nl2br}</div></div></xf:foreach><xf:else /><div class="block-row">Henüz mesaj bulunmuyor.</div></xf:if></div></div></div>
<xf:form action="{{ link('wrxt-hata-bildirimleri/reply') }}" class="block"><div class="block-container"><h2 class="block-header">Kullanıcıya cevap yaz</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:textarearow name="message" rows="5" maxlength="10000" autosize="true" label="Cevap" /></div><xf:submitrow submit="Cevabı gönder" /></div></xf:form>
<xf:form action="{{ link('wrxt-hata-bildirimleri/note') }}" class="block"><div class="block-container"><h2 class="block-header">İç not ekle</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:textarearow name="message" rows="4" maxlength="10000" autosize="true" label="Personel notu" /></div><xf:submitrow submit="İç notu kaydet" /></div></xf:form>
<div class="block"><div class="block-container"><h2 class="block-header">İşlem geçmişi</h2><div class="block-body"><xf:if is="$logs is not empty"><table class="dataList-table"><thead><tr><th>İşlem</th><th>Eski</th><th>Yeni</th><th>Yetkili ID</th><th>Tarih</th></tr></thead><tbody><xf:foreach loop="$logs" value="$log"><tr><td>{$log.action}</td><td>{$log.old_value}</td><td>{$log.new_value}</td><td>{$log.actor_user_id}</td><td><xf:date time="$log.created_date" /></td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Henüz işlem geçmişi oluşmadı.</div></xf:if></div></div></div>]]></template>

  <template type="admin" title="wrxt_hata_admin_analytics" version_id="1000130" version_string="1.0.5"><![CDATA[<xf:title>Hata Bildirim İstatistikleri</xf:title>
<xf:pageaction><xf:button href="{{ link('wrxt-hata-bildirimleri') }}" icon="back">Hata bildirimlerine dön</xf:button></xf:pageaction>
<div class="block"><div class="block-container"><h2 class="block-header">Rapor aralığı</h2><div class="block-body"><div class="block-row buttonGroup buttonGroup--inline"><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics', null, {'days': 7}) }}">7 gün</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics', null, {'days': 30}) }}">30 gün</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics', null, {'days': 90}) }}">90 gün</xf:button></div></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Genel özet · Son {$dashboard.days} gün</h2><div class="block-body"><div class="block-row"><div class="pairs-group pairs-group--columns"><dl class="pairs pairs--columns"><dt>Toplam rapor</dt><dd>{{ $dashboard.summary.total ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Açık rapor</dt><dd>{{ $dashboard.summary.open_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Çözülen</dt><dd>{{ $dashboard.summary.resolved_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Yinelenen</dt><dd>{{ $dashboard.summary.duplicate_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>JS hata kaydı</dt><dd>{{ $dashboard.summary.js_error_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Ağ hata kaydı</dt><dd>{{ $dashboard.summary.network_error_count ?: 0 }}</dd></dl></div></div></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Günlük hareket</h2><div class="block-body"><xf:if is="$dashboard.daily is not empty"><table class="dataList-table"><thead><tr><th>Gün</th><th>Rapor</th><th>Çözülen</th><th>JS</th><th>Ağ</th></tr></thead><tbody><xf:foreach loop="$dashboard.daily" value="$row"><tr><td>{$row.report_day}</td><td>{$row.report_count}</td><td>{$row.resolved_count}</td><td>{$row.js_error_count}</td><td>{$row.network_error_count}</td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Bu aralıkta rapor yok.</div></xf:if></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">En çok hata bildirilen sayfalar</h2><div class="block-body"><xf:if is="$dashboard.top_pages is not empty"><table class="dataList-table"><thead><tr><th>Sayfa</th><th>Rapor</th><th>Kullanıcı</th><th>Son bildirim</th></tr></thead><tbody><xf:foreach loop="$dashboard.top_pages" value="$row"><tr><td><a href="{$row.current_url}" target="_blank" rel="noopener noreferrer">{$row.current_url|snippet(120)}</a></td><td>{$row.report_count}</td><td>{$row.user_count}</td><td><xf:date time="$row.last_date" /></td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Sayfa istatistiği yok.</div></xf:if></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Tarayıcılar</h2><div class="block-body"><xf:foreach loop="$dashboard.browsers" value="$row"><div class="block-row"><dl class="pairs"><dt><xf:if is="$row.item_key">{$row.item_key}<xf:else />Bilinmiyor</xf:if></dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Cihaz türleri</h2><div class="block-body"><xf:foreach loop="$dashboard.devices" value="$row"><div class="block-row"><dl class="pairs"><dt><xf:if is="$row.item_key">{$row.item_key}<xf:else />Bilinmiyor</xf:if></dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Sorun türleri</h2><div class="block-body"><xf:foreach loop="$dashboard.categories" value="$row"><div class="block-row"><dl class="pairs"><dt><xf:if is="$row.item_key">{$row.item_key}<xf:else />Bilinmiyor</xf:if></dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>]]></template>
</templates>
