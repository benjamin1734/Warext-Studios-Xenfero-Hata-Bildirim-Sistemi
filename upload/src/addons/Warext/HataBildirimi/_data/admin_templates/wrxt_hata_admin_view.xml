<?xml version="1.0" encoding="utf-8"?>
<template title="wrxt_hata_admin_view"><![CDATA[<xf:title>{$report.report_key}</xf:title>
<xf:pageaction>
    <xf:button href="{{ link('wrxt-hata-bildirimleri') }}" icon="back">Hata listesine dön</xf:button>
    <xf:button href="{{ link('options/groups/wrxtHataSettings') }}" icon="cog">Ayarlar</xf:button>
    <xf:button href="{{ link('wrxt-hata-bildirimleri/analytics') }}">İstatistikler</xf:button>
</xf:pageaction>

<xf:if is="$report.PossibleDuplicate AND $report.status != 'duplicate'"><div class="blockMessage blockMessage--warning"><strong>Benzer hata adayı: {$report.PossibleDuplicate.report_key} · Güven {$report.duplicate_score}%</strong><br />Birleştirme yalnızca yetkili onayıyla yapılır.<div class="buttonGroup buttonGroup--inline u-mt-10"><xf:form action="{{ link('wrxt-hata-bildirimleri/duplicate') }}" ajax="true"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:hiddenval name="master_report_id" value="{$report.PossibleDuplicate.report_id}" /><xf:button type="submit" class="button--primary">{$report.PossibleDuplicate.report_key} ile birleştir</xf:button></xf:form><xf:form action="{{ link('wrxt-hata-bildirimleri/dismiss-duplicate') }}" ajax="true"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:button type="submit">Adayı reddet</xf:button></xf:form></div></div></xf:if>

<div class="block"><div class="block-container"><h2 class="block-header">{$report.report_key} · {$report.username}</h2><div class="block-body">
<div class="block-row"><h3 class="block-minorHeader">Kullanıcı açıklaması</h3><div class="bbWrapper">{$report.description|nl2br}</div></div>
<div class="block-row block-row--separated"><dl class="pairs pairs--columns pairs--fixedSmall">
<dt>Bildirim zamanı</dt><dd><xf:date time="$report.created_date" /></dd>
<dt>Sayfa</dt><dd><a href="{$report.current_url}" target="_blank" rel="noopener noreferrer">{$report.current_url}</a></dd>
<dt>Yönlendiren sayfa</dt><dd><xf:if is="$report.referrer_url"><a href="{$report.referrer_url}" target="_blank" rel="noopener noreferrer">{$report.referrer_url}</a><xf:else />Yok</xf:if></dd>
<dt>Rota</dt><dd>{$report.route_name ?: 'Algılanamadı'}</dd>
<dt>İçerik bağlamı</dt><dd><xf:if is="$report.content_type">{$report.content_type} #{$report.content_id}<xf:else />Algılanamadı</xf:if></dd>
<dt>Tarayıcı</dt><dd>{$report.browser_name} {$report.browser_version}</dd>
<dt>İşletim sistemi</dt><dd>{$report.os_name}</dd>
<dt>Cihaz</dt><dd>{$report.device_type}</dd>
<dt>Ekran</dt><dd>{$report.screen_width} × {$report.screen_height}</dd>
<dt>Görüntü alanı</dt><dd>{$report.viewport_width} × {$report.viewport_height}</dd>
<dt>Piksel oranı</dt><dd>{$report.pixel_ratio}</dd>
<dt>Tema</dt><dd><xf:if is="$style">{$style.title} (#{$report.style_id})<xf:else />#{$report.style_id}</xf:if></dd>
<xf:if is="$styleParent"><dt>Üst tema</dt><dd>{$styleParent.title} (#{$styleParent.style_id})</dd></xf:if>
<dt>Dil</dt><dd><xf:if is="$language">{$language.title} (#{$report.language_id})<xf:else />#{$report.language_id}</xf:if></dd>
<dt>Zaman dilimi</dt><dd>{$report.timezone ?: 'Algılanamadı'}</dd>
<dt>JavaScript</dt><dd><xf:if is="$report.js_enabled">Etkin<xf:else />Algılanamadı / kapalı</xf:if></dd>
<dt>JavaScript hatası</dt><dd>{$report.js_error_count}</dd>
<dt>Ağ isteği hatası</dt><dd>{$report.network_error_count}</dd>
<dt>Sunucu hata eşleşmesi</dt><dd><xf:if is="$report.server_error_id">#{$report.server_error_id} · {$report.server_error_score}%<xf:else />Yok</xf:if></dd>
<dt>Çözülen sürüm</dt><dd>{$report.fixed_in_version ?: 'Belirtilmedi'}</dd>
<dt>Ek dosya</dt><dd>{$report.attach_count}</dd>
</dl></div>
<xf:if is="$report.resolution_note"><div class="block-row block-row--separated"><h3 class="block-minorHeader">Çözüm notu</h3><div class="bbWrapper">{$report.resolution_note|nl2br}</div></div></xf:if>
<xf:if is="$report.Attachments is not empty"><div class="block-row block-row--separated"><h3 class="block-minorHeader">Ek dosyalar</h3><ul><xf:foreach loop="$report.Attachments" value="$attachment"><li><a href="{{ link('attachments', $attachment) }}" target="_blank" rel="noopener">{$attachment.Data.filename}</a> · {{ file_size($attachment.Data.file_size) }}</li></xf:foreach></ul></div></xf:if>
</div></div></div>

<xf:if is="$serverError is not empty"><div class="block"><div class="block-container"><h2 class="block-header">XenForo sunucu hata korelasyonu</h2><div class="block-body">
<div class="block-row"><div class="blockMessage blockMessage--important">Bu kayıt XenForo sunucu hata günlüğüyle <strong>{$report.server_error_score}%</strong> güven puanıyla eşleştirildi. POST verileri ve IP adresi bu rapora kopyalanmadı.</div></div>
<div class="block-row block-row--separated"><dl class="pairs pairs--columns pairs--fixedSmall"><dt>Hata ID</dt><dd>#{$report.server_error_id}</dd><dt>Tür</dt><dd>{$serverError.type}</dd><dt>Zaman</dt><dd><xf:date time="$serverError.date" /></dd><dt>Dosya</dt><dd>{$serverError.file}:{$serverError.line}</dd></dl></div>
<div class="block-row block-row--separated"><strong>{$serverError.message}</strong></div>
<xf:if is="$serverError.trace"><div class="block-row block-row--separated"><pre class="code">{$serverError.trace}</pre></div></xf:if>
</div></div></div></xf:if>

<xf:if is="$clientErrors is not empty OR $networkErrors is not empty"><div class="block"><div class="block-container"><h2 class="block-header">Otomatik teknik tanılama</h2><div class="block-body">
<xf:if is="$clientErrors is not empty"><div class="block-row"><h3 class="block-minorHeader">JavaScript hataları</h3><xf:foreach loop="$clientErrors" value="$diag"><div class="wrxtHata-diagnosticItem"><div><span class="label label--red">{$diag.type}</span> <strong>{$diag.message}</strong></div><div class="u-muted">{$diag.source}</div><xf:if is="$diag.stack"><pre class="code">{$diag.stack}</pre></xf:if></div></xf:foreach></div></xf:if>
<xf:if is="$networkErrors is not empty"><div class="block-row block-row--separated"><h3 class="block-minorHeader">Başarısız ağ istekleri</h3><xf:foreach loop="$networkErrors" value="$diag"><div class="wrxtHata-diagnosticItem"><div><span class="label label--orange">{$diag.transport}</span> <strong>{$diag.method} · HTTP {$diag.status}</strong></div><div><code>{$diag.url}</code></div></div></xf:foreach></div></xf:if>
</div></div></div></xf:if>

<xf:form action="{{ link('wrxt-hata-bildirimleri/update') }}" class="block"><div class="block-container"><h2 class="block-header">Rapor yönetimi</h2><div class="block-body">
<xf:hiddenval name="report_id" value="{$report.report_id}" />
<xf:selectrow name="status" value="{$report.status}" label="Durum"><xf:option value="new">Yeni</xf:option><xf:option value="investigating">İnceleniyor</xf:option><xf:option value="confirmed">Onaylandı</xf:option><xf:option value="in_progress">Çözülüyor</xf:option><xf:option value="resolved">Çözüldü</xf:option><xf:option value="cannot_reproduce">Tekrar üretilemedi</xf:option><xf:option value="invalid">Geçersiz</xf:option><xf:option value="duplicate">Yinelenen</xf:option><xf:option value="archived">Arşivlendi</xf:option></xf:selectrow>
<xf:selectrow name="assignee_user_id" value="{$report.assignee_user_id}" label="Atanan personel"><xf:option value="0">Atanmamış</xf:option><xf:foreach loop="$staff" value="$staffUser"><xf:option value="{$staffUser.user_id}">{$staffUser.username}</xf:option></xf:foreach></xf:selectrow>
<xf:textboxrow name="fixed_in_version" value="{$report.fixed_in_version}" maxlength="100" label="Çözülen sürüm" placeholder="Örn. 2.4.1 / 2026.08.24" />
<xf:textarearow name="resolution_note" value="{$report.resolution_note}" rows="4" maxlength="10000" autosize="true" label="Çözüm notu" />
</div><xf:submitrow submit="Kaydet" /></div></xf:form>

<xf:if is="$report.status != 'duplicate'"><xf:form action="{{ link('wrxt-hata-bildirimleri/duplicate') }}" class="block"><div class="block-container"><h2 class="block-header">Manuel yinelenen birleştirme</h2><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:numberboxrow name="master_report_id" min="1" label="Ana rapor ID" /></div><xf:submitrow submit="Yinelenen olarak birleştir" /></div></xf:form></xf:if>

<xf:if is="$duplicateChildren is not empty"><div class="block"><div class="block-container"><h2 class="block-header">Bu rapora bağlanan yinelenen bildirimler</h2><div class="block-body"><xf:foreach loop="$duplicateChildren" value="$child"><div class="block-row"><a href="{{ link('wrxt-hata-bildirimleri/view', null, {'report_id': $child.report_id}) }}">{$child.report_key}</a> · {$child.username} · <xf:date time="$child.created_date" /></div></xf:foreach></div></div></div></xf:if>

<div class="block"><div class="block-container"><h2 class="block-header">Yazışmalar ve ekip notları</h2><div class="block-body"><xf:if is="$messages is not empty"><xf:foreach loop="$messages" value="$item"><div class="block-row block-row--separated"><strong>{$item.username}</strong> <xf:if is="$item.message_type == 'note'"><span class="label label--orange">İç not</span><xf:elseif is="$item.message_type == 'staff'" /><span class="label label--blue">Yetkili cevabı</span></xf:if><div class="u-muted"><xf:date time="$item.created_date" /></div><div class="bbWrapper">{$item.message|nl2br}</div></div></xf:foreach><xf:else /><div class="block-row">Henüz ek mesaj bulunmuyor.</div></xf:if></div></div></div>

<div class="block"><div class="block-container"><h2 class="block-header">Kullanıcıya cevap yaz</h2><xf:form action="{{ link('wrxt-hata-bildirimleri/reply') }}"><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:textarearow name="message" rows="5" maxlength="10000" autosize="true" label="Cevap" /></div><xf:submitrow submit="Cevabı gönder" /></xf:form></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">İç not ekle</h2><xf:form action="{{ link('wrxt-hata-bildirimleri/note') }}"><div class="block-body"><xf:hiddenval name="report_id" value="{$report.report_id}" /><xf:textarearow name="message" rows="4" maxlength="10000" autosize="true" label="Personel notu" /></div><xf:submitrow submit="İç notu kaydet" /></xf:form></div></div>

<div class="block"><div class="block-container"><h2 class="block-header">İşlem geçmişi</h2><div class="block-body"><xf:if is="$logs is not empty"><table class="dataList-table"><thead><tr><th>İşlem</th><th>Eski</th><th>Yeni</th><th>Yetkili ID</th><th>Tarih</th></tr></thead><tbody><xf:foreach loop="$logs" value="$log"><tr><td>{$log.action}</td><td>{$log.old_value}</td><td>{$log.new_value}</td><td>{$log.actor_user_id}</td><td><xf:date time="$log.created_date" /></td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Henüz işlem geçmişi oluşmadı.</div></xf:if></div></div></div>]]></template>
