<?xml version="1.0" encoding="utf-8"?>
<template title="wrxt_hata_admin_analytics"><![CDATA[<xf:title>Hata Bildirim İstatistikleri</xf:title>
<xf:pageaction><xf:button href="{{ link('wrxt-hata-bildirimleri') }}" icon="back">Hata bildirimlerine dön</xf:button></xf:pageaction>
<div class="block"><div class="block-container"><h2 class="block-header">Rapor aralığı</h2><div class="block-body"><div class="block-row buttonGroup buttonGroup--inline"><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics', null, {'days': 7}) }}" class="{{ $days == 7 ? 'button--primary' : '' }}">7 gün</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics', null, {'days': 30}) }}" class="{{ $days == 30 ? 'button--primary' : '' }}">30 gün</xf:button><xf:button href="{{ link('wrxt-hata-bildirimleri/analytics', null, {'days': 90}) }}" class="{{ $days == 90 ? 'button--primary' : '' }}">90 gün</xf:button></div></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Genel özet · Son {$dashboard.days} gün</h2><div class="block-body"><div class="block-row"><div class="pairs-group pairs-group--columns"><dl class="pairs pairs--columns"><dt>Toplam rapor</dt><dd>{{ $dashboard.summary.total ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Açık rapor</dt><dd>{{ $dashboard.summary.open_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Çözülen</dt><dd>{{ $dashboard.summary.resolved_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Yinelenen</dt><dd>{{ $dashboard.summary.duplicate_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>JS hata kaydı</dt><dd>{{ $dashboard.summary.js_error_count ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Ağ hata kaydı</dt><dd>{{ $dashboard.summary.network_error_count ?: 0 }}</dd></dl></div></div><div class="block-row block-row--separated"><div class="pairs-group pairs-group--columns"><dl class="pairs pairs--columns"><dt>JS hatalı rapor</dt><dd>{{ $dashboard.summary.reports_with_js_errors ?: 0 }}</dd></dl><dl class="pairs pairs--columns"><dt>Ağ hatalı rapor</dt><dd>{{ $dashboard.summary.reports_with_network_errors ?: 0 }}</dd></dl></div></div></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Günlük hareket</h2><div class="block-body"><xf:if is="$dashboard.daily is not empty"><table class="dataList-table"><thead><tr><th>Gün</th><th>Rapor</th><th>Çözülen</th><th>JS hatası</th><th>Ağ hatası</th></tr></thead><tbody><xf:foreach loop="$dashboard.daily" value="$row"><tr><td>{$row.report_day}</td><td><strong>{$row.report_count}</strong></td><td>{$row.resolved_count}</td><td>{$row.js_error_count}</td><td>{$row.network_error_count}</td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Bu tarih aralığında rapor bulunmuyor.</div></xf:if></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">En çok hata bildirilen sayfalar</h2><div class="block-body"><xf:if is="$dashboard.top_pages is not empty"><table class="dataList-table"><thead><tr><th>Sayfa</th><th>Rapor</th><th>Kullanıcı</th><th>JS</th><th>Ağ</th><th>Son bildirim</th></tr></thead><tbody><xf:foreach loop="$dashboard.top_pages" value="$row"><tr><td><a href="{$row.current_url}" target="_blank" rel="noopener noreferrer">{$row.current_url|snippet(120)}</a></td><td><strong>{$row.report_count}</strong></td><td>{$row.user_count}</td><td>{$row.js_error_count}</td><td>{$row.network_error_count}</td><td><xf:date time="$row.last_date" /></td></tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Sayfa istatistiği bulunmuyor.</div></xf:if></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Sorun türleri</h2><div class="block-body"><xf:foreach loop="$dashboard.categories" value="$row"><div class="block-row"><dl class="pairs"><dt>{$row.item_key ?: 'Bilinmiyor'}</dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Tarayıcılar</h2><div class="block-body"><xf:foreach loop="$dashboard.browsers" value="$row"><div class="block-row"><dl class="pairs"><dt>{$row.item_key ?: 'Bilinmiyor'}</dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Cihaz türleri</h2><div class="block-body"><xf:foreach loop="$dashboard.devices" value="$row"><div class="block-row"><dl class="pairs"><dt>{$row.item_key ?: 'Bilinmiyor'}</dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">Temalar</h2><div class="block-body"><xf:foreach loop="$dashboard.styles" value="$row"><div class="block-row"><dl class="pairs"><dt>Style #{$row.item_key}</dt><dd>{$row.report_count}</dd></dl></div></xf:foreach></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">İçerik bağlamları</h2><div class="block-body"><xf:if is="$dashboard.contexts is not empty"><xf:foreach loop="$dashboard.contexts" value="$row"><div class="block-row"><dl class="pairs"><dt>{$row.item_key}</dt><dd>{$row.report_count}</dd></dl></div></xf:foreach><xf:else /><div class="block-row">Algılanan içerik bağlamı bulunmuyor.</div></xf:if></div></div></div>]]></template>
