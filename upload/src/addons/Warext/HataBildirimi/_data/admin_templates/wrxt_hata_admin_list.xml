<?xml version="1.0" encoding="utf-8"?>
<template title="wrxt_hata_admin_list"><![CDATA[<xf:title>Hata Bildirimleri</xf:title>
<xf:pageaction>
    <xf:button href="{{ link('options/groups/wrxtHataSettings') }}" icon="cog">Ayarlar</xf:button>
    <xf:button href="{{ link('wrxt-hata-bildirimleri/analytics') }}" icon="chart">İstatistikler</xf:button>
</xf:pageaction>

<div class="block"><div class="block-container"><h2 class="block-header">Genel durum</h2><div class="block-body"><div class="block-row"><div class="pairs-group pairs-group--columns">
<dl class="pairs pairs--columns"><dt>Yeni</dt><dd>{{ $stats.new ?: 0 }}</dd></dl>
<dl class="pairs pairs--columns"><dt>İnceleniyor</dt><dd>{{ $stats.investigating ?: 0 }}</dd></dl>
<dl class="pairs pairs--columns"><dt>Onaylandı</dt><dd>{{ $stats.confirmed ?: 0 }}</dd></dl>
<dl class="pairs pairs--columns"><dt>Çözülüyor</dt><dd>{{ $stats.in_progress ?: 0 }}</dd></dl>
<dl class="pairs pairs--columns"><dt>Çözüldü</dt><dd>{{ $stats.resolved ?: 0 }}</dd></dl>
</div></div></div></div></div>

<xf:if is="$hotspots is not empty"><div class="block"><div class="block-container"><h2 class="block-header">Yoğun hata sinyalleri · Son 30 dakika</h2><div class="block-body"><table class="dataList-table"><thead><tr><th>Sayfa</th><th>Bildirim</th><th>Kullanıcı</th><th>Son bildirim</th></tr></thead><tbody><xf:foreach loop="$hotspots" value="$hotspot"><tr><td><a href="{$hotspot.current_url}" target="_blank" rel="noopener noreferrer">{$hotspot.current_url|snippet(110)}</a></td><td><strong>{$hotspot.report_count}</strong></td><td>{$hotspot.user_count}</td><td><xf:date time="$hotspot.last_date" /></td></tr></xf:foreach></tbody></table></div></div></div></xf:if>

<xf:form action="{{ link('wrxt-hata-bildirimleri') }}" method="get" class="block"><div class="block-container"><h2 class="block-header">Filtrele</h2><div class="block-body">
<xf:textboxrow name="q" value="{$q}" label="Rapor veya kullanıcı" placeholder="BUG-A1B2C3D4, rapor ID veya kullanıcı adı" />
<xf:selectrow name="status" value="{$status}" label="Durum"><xf:option value="">Tümü</xf:option><xf:option value="new">Yeni</xf:option><xf:option value="investigating">İnceleniyor</xf:option><xf:option value="confirmed">Onaylandı</xf:option><xf:option value="in_progress">Çözülüyor</xf:option><xf:option value="resolved">Çözüldü</xf:option><xf:option value="cannot_reproduce">Tekrar üretilemedi</xf:option><xf:option value="invalid">Geçersiz</xf:option><xf:option value="duplicate">Yinelenen</xf:option><xf:option value="archived">Arşivlendi</xf:option></xf:selectrow>
<xf:selectrow name="category" value="{$category}" label="Sorun türü"><xf:option value="">Tümü</xf:option><xf:option value="page">Sayfa çalışmıyor</xf:option><xf:option value="visual">Görsel / tasarım</xf:option><xf:option value="feature">Buton / özellik</xf:option><xf:option value="mobile">Mobil uyumluluk</xf:option><xf:option value="performance">Performans</xf:option><xf:option value="permission">Yetki</xf:option><xf:option value="other">Diğer</xf:option></xf:selectrow>
<xf:selectrow name="assignee_user_id" value="{$assigneeUserId}" label="Atanan personel"><xf:option value="0">Tümü</xf:option><xf:foreach loop="$staff" value="$staffUser"><xf:option value="{$staffUser.user_id}">{$staffUser.username}</xf:option></xf:foreach></xf:selectrow>
</div><xf:submitrow submit="Filtrele" /></div></xf:form>

<xf:form action="{{ link('wrxt-hata-bildirimleri/bulk') }}" class="block">
<div class="block-container"><h2 class="block-header">Hata raporları</h2><div class="block-body">
<xf:if is="$reports is not empty"><table class="dataList-table"><thead><tr><th></th><th>Rapor</th><th>Kullanıcı</th><th>Bağlam</th><th>Durum</th><th>Tanılama</th><th>Atanan</th><th>Tarih</th></tr></thead><tbody>
<xf:foreach loop="$reports" value="$report"><tr>
<td><input type="checkbox" name="report_ids[]" value="{$report.report_id}" /></td>
<td><a href="{{ link('wrxt-hata-bildirimleri/view', null, {'report_id': $report.report_id}) }}"><strong>{$report.report_key}</strong></a> <xf:if is="$report.possible_duplicate_report_id"><span class="label label--orange">Benzer {$report.duplicate_score}%</span></xf:if> <xf:if is="$report.server_error_id"><span class="label label--red">Sunucu #{$report.server_error_id} · {$report.server_error_score}%</span></xf:if> <xf:if is="$report.fixed_in_version"><span class="label label--green">{$report.fixed_in_version}</span></xf:if><div class="u-muted">{$report.description|snippet(90)}</div></td>
<td>{$report.username}</td>
<td><xf:if is="$report.content_type">{$report.content_type} #{$report.content_id}<xf:else />{$report.category}</xf:if></td>
<td><xf:if is="$report.status == 'new'">Yeni<xf:elseif is="$report.status == 'investigating'" />İnceleniyor<xf:elseif is="$report.status == 'confirmed'" />Onaylandı<xf:elseif is="$report.status == 'in_progress'" />Çözülüyor<xf:elseif is="$report.status == 'resolved'" />Çözüldü<xf:elseif is="$report.status == 'cannot_reproduce'" />Tekrar üretilemedi<xf:elseif is="$report.status == 'invalid'" />Geçersiz<xf:elseif is="$report.status == 'duplicate'" />Yinelenen<xf:else />Arşivlendi</xf:if></td>
<td><xf:if is="$report.js_error_count"><span class="label label--red">JS {$report.js_error_count}</span></xf:if> <xf:if is="$report.network_error_count"><span class="label label--orange">HTTP {$report.network_error_count}</span></xf:if><xf:if is="!$report.js_error_count AND !$report.network_error_count AND !$report.server_error_id"><span class="u-muted">Yok</span></xf:if></td>
<td><xf:if is="$report.Assignee">{$report.Assignee.username}<xf:else />Atanmamış</xf:if></td><td><xf:date time="$report.created_date" /></td>
</tr></xf:foreach></tbody></table><xf:else /><div class="block-row">Filtreye uygun hata bildirimi bulunamadı.</div></xf:if>
</div>
<xf:if is="$reports is not empty"><div class="block-body">
<xf:selectrow name="bulk_action" label="Toplu işlem"><xf:option value="status">Durum değiştir</xf:option><xf:option value="assign">Personele ata</xf:option><xf:option value="resolve">Çözüldü olarak işaretle</xf:option><xf:option value="archive">Arşivle</xf:option></xf:selectrow>
<xf:selectrow name="bulk_status" value="investigating" label="Yeni durum"><xf:option value="new">Yeni</xf:option><xf:option value="investigating">İnceleniyor</xf:option><xf:option value="confirmed">Onaylandı</xf:option><xf:option value="in_progress">Çözülüyor</xf:option><xf:option value="resolved">Çözüldü</xf:option><xf:option value="cannot_reproduce">Tekrar üretilemedi</xf:option><xf:option value="invalid">Geçersiz</xf:option><xf:option value="archived">Arşivlendi</xf:option></xf:selectrow>
<xf:selectrow name="bulk_assignee_user_id" label="Atanacak personel"><xf:option value="0">Atamayı kaldır</xf:option><xf:foreach loop="$staff" value="$staffUser"><xf:option value="{$staffUser.user_id}">{$staffUser.username}</xf:option></xf:foreach></xf:selectrow>
<xf:textboxrow name="fixed_in_version" maxlength="100" label="Çözülen sürüm" placeholder="Örn. 2.4.1 / 2026.08.24" />
<xf:textarearow name="resolution_note" maxlength="10000" rows="3" autosize="true" label="Çözüm notu" />
</div><xf:submitrow submit="Seçili raporlara uygula" /></xf:if>
<xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-hata-bildirimleri" params="{{ {'q': $q, 'status': $status, 'category': $category, 'assignee_user_id': $assigneeUserId} }}" wrapperclass="block-outer block-outer--after" />
</div></xf:form>]]></template>
